<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Vulnerable-dependency audit stays a warning: Renovate's vulnerabilityAlerts own it; an advisory must not redden unrelated PRs. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SourceLink is built into the .NET SDK (8+); Deterministic is the SDK default. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Package validation: off for 3.0.0 (intentionally breaking). Follow-up after 3.0.0 is on nuget.org:
         EnablePackageValidation=true + PackageValidationBaselineVersion=3.0.0. -->
  </PropertyGroup>

  <!-- Package metadata shared by every package in src/. Each csproj keeps PackageId, Version, Description and PackageTags. -->
  <PropertyGroup>
    <Authors>Atypical Consulting</Authors>
    <Company>Atypical Consulting</Company>
    <Copyright>Copyright (c) Atypical Consulting</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Atypical-Consulting/TheAppManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Atypical-Consulting/TheAppManager</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/Atypical-Consulting/TheAppManager/blob/dev/CHANGELOG.md</PackageReleaseNotes>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Each package ships its own short NUGET.md as README.md; the repo README is too long for nuget.org. -->
    <None Include="$(MSBuildProjectDirectory)/NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)../logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
