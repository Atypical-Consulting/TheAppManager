<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TheAppManager.Testing</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>TheAppManager.Testing</PackageId>
    <Version>3.0.0</Version> <!-- x-release-please-version -->
    <Description>Test helpers for TheAppManager: a production-faithful, TestServer-backed AppModuleTestHost and WebApplicationFactory module replacement.</Description>
    <PackageTags>aspnetcore;modules;testing;testserver;integration-tests</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheAppManager\TheAppManager.csproj" />
  </ItemGroup>

</Project>
