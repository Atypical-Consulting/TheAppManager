<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TheAppManager</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>TheAppManager</PackageId>
    <Version>2.1.0</Version>
    <Authors>phmatray</Authors>
    <Copyright>Copyright (c) phmatray</Copyright>
    <Description>A lightweight, composable module system for ASP.NET Core application startup. Organize services, middleware, and endpoints into independent, reusable modules with auto-discovery support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/phmatray/TheAppManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aspnetcore;modules;composable;startup;auto-discovery;minimal-api</PackageTags>
    <PackageProjectUrl>https://github.com/phmatray/TheAppManager</PackageProjectUrl>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReleaseNotes>v2.1.0: Added AppManager.StartAsync for async application startup.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheAppManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

</Project>
