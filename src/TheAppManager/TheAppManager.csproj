<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TheAppManager</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- NuGet Package Metadata -->
    <PackageId>TheAppManager</PackageId>
    <Version>2.2.0</Version> <!-- x-release-please-version -->
    <Description>Compose ASP.NET Core, worker and console startup from ordered, testable modules: AddModules, UseModules and MapModules extensions on the builder you already have. Trimming and Native AOT compatible.</Description>
    <PackageTags>aspnetcore;modules;composable;startup;minimal-api;generic-host;worker;console;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheAppManager.Tests" />
  </ItemGroup>

</Project>
